# Environment Variables for AMI Agents

# LLM API Keys (OpenAI - used by RD5)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=4096
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SPADE Server Configuration
SPADE_SERVER=localhost
SPADE_PORT=5222

# HomeAssistant Configuration
HOMEASSISTANT_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=your_long_lived_access_token_here

# Database Configuration
DATABASE_URL=sqlite:///data/ami_agents.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ami_agents.log

# External Services API Keys
WEATHER_API_KEY=your_weather_api_key_here
AIR_QUALITY_API_KEY=your_air_quality_api_key_here

# Google Services (if using)
GOOGLE_CREDENTIALS_PATH=credentials/google_credentials.json

# ===========================================
# RD5 Plan Orchestrator Configuration
# ===========================================

# Weaviate Vector Database
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8081
WEAVIATE_GRPC_PORT=50051

# RD4 Signifier API
RD4_API_URL=http://localhost:8000
RD4_API_TIMEOUT=30.0

# HMAS/Yggdrasil Configuration
HMAS_BASE_URL=http://localhost:8090

# Sandbox Execution Settings
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_NETWORK=rd5_sandbox_net
