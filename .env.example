# Environment Variables for AMI Agents

# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SPADE Server Configuration
SPADE_HOST=localhost
SPADE_PORT=5222
SPADE_TLS=false

# SPADE Agent Passwords
# For testing/demos, you can use SPADE_PASSWORD for all agents
# For production, use individual passwords for each agent
SPADE_PASSWORD=password

# Individual agent passwords (optional - if not set, SPADE_PASSWORD is used)
SPADE_USER_ASSISTANT_PASSWORD=user_assistant_password
SPADE_ENV_EXPLORER_PASSWORD=env_explorer_password
SPADE_INTERACTION_SOLVER_PASSWORD=interaction_solver_password

# HomeAssistant Configuration
HOMEASSISTANT_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=your_long_lived_access_token_here

# Environment Control
ENV_DISCOVERY_METHOD=mdns
CURRENT_ENVIRONMENT=lab308

# Environment Configurations (Demo/Development)
LAB308_YGGDRASIL_URL=http://localhost:8080
LAB308_HA_URL=http://localhost:8123
HOMEBENCH_YGGDRASIL_URL=http://localhost:8090
HOMEBENCH_HA_URL=http://localhost:8124
COMMUNITY_API_URL=http://localhost:8085
COMMUNITY_TIMEOUT=10.0

# Yggdrasil HomeAssistant Adapter Configuration
HA_TOKEN=your_homeassistant_token_here
HA_URL=ws://localhost:8123/api/websocket
AREAS=lab308
BASE_WS_URI=http://localhost:8080/
PORT=8080
INTEGRATION_ENGINE_PORT=8086
SEMANTIC_CONFIG=lab308.yaml

# Database Configuration
DATABASE_URL=sqlite:///data/ami_agents.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ami_agents.log

# Timeouts Configuration
LLM_TIMEOUT_DEFAULT=30.0
LLM_TIMEOUT_REASONING=120.0
HTTP_CLIENT_TIMEOUT=30.0
COMMUNITY_API_TIMEOUT=10.0
HA_API_TIMEOUT=10.0
SIGNIFIER_MATCH_TIMEOUT=10.0
RPC_TIMEOUT=15.0
CONVERSATION_TIMEOUT=1800

# Signifier Configuration
SIGNIFIER_MIN_SIMILARITY=0.5
SIGNIFIER_MATCHER_VERSION=v2

# BT Execution Configuration
BT_MAX_TICKS_DEFAULT=10
BT_MAX_TICKS_USER_ASSISTANT=50
HTTP_MAX_RETRIES=3
# Shortest pause between ticks of a RUNNING tree. Node I/O runs on a thread
# pool, so a loop that never sleeps outruns the request it is waiting for.
BT_MIN_TICK_YIELD=0.01
# Maintenance plans tick in bursts (same budget and cadence as any other plan),
# then stand down for this long before looking again.
BT_MAINTENANCE_INTERVAL=180.0
# How soon a standing-down maintenance plan notices a trigger asking it to
# start a burst early.
BT_MAINTENANCE_TRIGGER_POLL=10.0

# UserAssistant Configuration
# How long an action plan waits for a yes/no before assuming confirmation.
# Read-only plans auto-confirm and never wait.
UA_CONFIRMATION_TIMEOUT=5.0

# External Services API Keys
WEATHER_API_KEY=your_weather_api_key_here
AIR_QUALITY_API_KEY=your_air_quality_api_key_here

# Google Services (if using)
GOOGLE_CREDENTIALS_PATH=credentials/google_credentials.json
