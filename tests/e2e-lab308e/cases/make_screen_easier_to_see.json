{
  "name": "make_screen_easier_to_see_reduces_screen_glare",
  "initial_state": [
    {
      "type": "request",
      "method": "POST",
      "path": "/workspaces/lab308e/artifacts/projector_308e/ha/media_player/turn_on",
      "json": {},
      "expect_status": 200
    },
    {
      "type": "request",
      "method": "POST",
      "path": "/workspaces/lab308e/artifacts/blackout_blinds_308e_cover/ha/cover/open_cover",
      "json": {},
      "expect_status": 200
    },
    {
      "type": "sleep",
      "seconds": 2
    }
  ],
  "query": "make the screen easier to see",
  "semantic_expectations": {
    "target_properties": ["glare"],
    "preferred_artifacts": ["blackout_blinds_308e_cover"],
    "acceptable_artifacts": ["blackout_blinds_308e_cover", "blinds_308e_cover", "window_308e_cover", "ambient_lights_308e", "task_lights_308e", "desk_lamp_308e"],
    "forbidden_artifacts": ["air_conditioner_308e", "heater_308e"],
    "must_avoid_exact_numeric_thresholds": true
  },
  "clarification_replies": [
    {
      "match_type": "regex",
      "match": "(?i)(which screen|do you mean.*projector|do you mean.*display.*projector|wall display.*projector)",
      "reply": "the projector"
    },
    {
      "match_type": "regex",
      "match": "(?i)(what would you like me to do with the projector|control the projector|projector.*status|turn it on/off|change input|mute volume)",
      "reply": "reduce glare"
    },
    {
      "match_type": "regex",
      "match": "(?i)(reduce the glare|how would you like me to reduce the glare|dim the lights|close the blinds|lower the blackout blinds)",
      "reply": "lower the blackout blinds"
    },
    {
      "match_type": "regex",
      "match": "(?i)(which device should i adjust|which would you like me to adjust|the display|the projector|the room lights|the blinds)",
      "reply": "the blackout blinds"
    },
    {
      "match_type": "regex",
      "match": "(?i)(increase display brightness|reduce ambient light|make the screen easier to see)",
      "reply": "reduce ambient light"
    }
  ],
  "auto_confirm": true,
  "confirmation_text": "yes",
  "response_timeout_seconds": 300,
  "settle_seconds": 4,
  "pass_criteria": [
    {
      "type": "any_of",
      "assertions": [
        {
          "type": "property_lte",
          "path": "/workspaces/lab308e/artifacts/glare_sensing_308e/properties/state",
          "lte": 50,
          "timeout_seconds": 30,
          "poll_interval_seconds": 1
        },
        {
          "type": "property_equals",
          "path": "/workspaces/lab308e/artifacts/blackout_blinds_308e_cover/properties/state",
          "equals": "closed",
          "timeout_seconds": 30,
          "poll_interval_seconds": 1
        }
      ]
    },
    {
      "type": "final_reply_contains",
      "value": "success"
    }
  ]
}
