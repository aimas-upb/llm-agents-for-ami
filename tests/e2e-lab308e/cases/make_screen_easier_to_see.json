{
  "name": "make_screen_easier_to_see_reduces_screen_glare",
  "initial_state": [
    {
      "type": "request",
      "method": "POST",
      "path": "/workspaces/lab308e/artifacts/projector_308e/ha/media_player/turn_on",
      "json": {},
      "expect_status": 200
    },
    {
      "type": "request",
      "method": "POST",
      "path": "/workspaces/lab308e/artifacts/blackout_blinds_308e_cover/ha/cover/open_cover",
      "json": {},
      "expect_status": 200
    },
    {
      "type": "sleep",
      "seconds": 2
    }
  ],
  "query": "make the screen easier to see",
  "clarification_replies": [
    {
      "match_type": "regex",
      "match": "(?i)(which|do you mean).*(display wall).*(projector)|(projector).*(display wall)",
      "reply": "the projector"
    },
    {
      "match_type": "regex",
      "match": "(?i)increase the display brightness.*reduce ambient light|reduce ambient light.*increase the display brightness",
      "reply": "reduce ambient light"
    },
    {
      "match_type": "regex",
      "match": "(?i)what would you like me to do with the projector",
      "reply": "reduce glare"
    },
    {
      "match_type": "regex",
      "match": "(?i)do you want to control the projector.*or just check its status",
      "reply": "reduce glare"
    }
  ],
  "auto_confirm": true,
  "confirmation_text": "yes",
  "response_timeout_seconds": 300,
  "settle_seconds": 4,
  "pass_criteria": [
    {
      "type": "any_of",
      "assertions": [
        {
          "type": "property_lte",
          "path": "/workspaces/lab308e/artifacts/glare_sensing_308e/properties/state",
          "lte": 50,
          "timeout_seconds": 30,
          "poll_interval_seconds": 1
        },
        {
          "type": "property_equals",
          "path": "/workspaces/lab308e/artifacts/blackout_blinds_308e_cover/properties/state",
          "equals": "closed",
          "timeout_seconds": 30,
          "poll_interval_seconds": 1
        }
      ]
    },
    {
      "type": "final_reply_contains",
      "value": "success"
    }
  ]
}
