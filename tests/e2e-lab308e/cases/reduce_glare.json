{
  "name": "reduce_glare_closes_blackout_blinds",
  "initial_state": [
    {
      "type": "request",
      "method": "POST",
      "path": "/workspaces/lab308e/artifacts/blackout_blinds_308e_cover/ha/cover/open_cover",
      "json": {},
      "expect_status": 200
    },
    {
      "type": "sleep",
      "seconds": 2
    }
  ],
  "query": "reduce glare",
  "semantic_expectations": {
    "target_properties": ["glare"],
    "preferred_artifacts": ["blackout_blinds_308e_cover"],
    "acceptable_artifacts": ["blackout_blinds_308e_cover", "blinds_308e_cover", "window_308e_cover", "ambient_lights_308e", "task_lights_308e", "desk_lamp_308e"],
    "forbidden_artifacts": ["projector_308e", "display_wall_308e", "air_conditioner_308e", "heater_308e"],
    "must_avoid_exact_numeric_thresholds": true
  },
  "clarification_replies": [
    {
      "match_type": "regex",
      "match": "(?i)(would you like me|do you want me).*?(close|lower).*?blinds.*?dim.*?lights.*?glare",
      "reply": "close the blackout blinds"
    },
    {
      "match_type": "regex",
      "match": "(?i)which device should i adjust.*reduce glare.*(blinds|lights|display|projector|ambient/task lights|window blinds|blackout blinds)",
      "reply": "the blackout blinds"
    },
    {
      "match_type": "regex",
      "match": "(?i)what would you like me to do with the blackout blinds.*(open|close|set (a )?position|check (their )?status)",
      "reply": "close the blackout blinds"
    },
    {
      "match_type": "regex",
      "match": "(?i)what would you like me to do with the blackout blinds\\??",
      "reply": "close the blackout blinds"
    },
    {
      "match_type": "regex",
      "match": "(?i)reduce( the)? glare.*((closing|close|lowering|lower).*blinds|dimming.*lights)",
      "reply": "close the blackout blinds"
    }
  ],
  "auto_confirm": true,
  "confirmation_text": "yes",
  "settle_seconds": 8,
  "pass_criteria": [
    {
      "type": "property_in",
      "path": "/workspaces/lab308e/artifacts/blackout_blinds_308e_cover/properties/state",
      "values": ["closed", "closing"],
      "timeout_seconds": 60,
      "poll_interval_seconds": 1
    },
    {
      "type": "final_reply_contains",
      "value": "success"
    }
  ]
}
