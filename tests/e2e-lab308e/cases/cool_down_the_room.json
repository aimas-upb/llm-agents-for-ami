{
  "name": "cool_down_the_room_reduces_heat_or_ventilates",
  "initial_state": [
    {
      "type": "request",
      "method": "POST",
      "path": "/workspaces/lab308e/artifacts/heater_308e/ha/climate/set_hvac_mode",
      "json": {
        "hvac_mode": "off"
      },
      "expect_status": 200
    },
    {
      "type": "request",
      "method": "POST",
      "path": "/workspaces/lab308e/artifacts/window_308e_cover/ha/cover/close_cover",
      "json": {},
      "expect_status": 200
    },
    {
      "type": "request",
      "method": "POST",
      "path": "/workspaces/lab308e/artifacts/ceiling_fan_308e/ha/switch/turn_off",
      "json": {},
      "expect_status": 200
    },
    {
      "type": "sleep",
      "seconds": 2
    }
  ],
  "query": "cool down the room",
  "semantic_expectations": {
    "target_properties": ["thermal_comfort"],
    "preferred_artifacts": ["air_conditioner_308e", "ceiling_fan_308e", "window_308e_cover"],
    "acceptable_artifacts": ["air_conditioner_308e", "ceiling_fan_308e", "window_308e_cover", "heater_308e"],
    "forbidden_artifacts": ["projector_308e", "display_wall_308e"],
    "must_avoid_exact_numeric_thresholds": true
  },
  "auto_confirm": true,
  "confirmation_text": "yes",
  "settle_seconds": 8,
  "pass_criteria": [
    {
      "type": "any_of",
      "assertions": [
        {
          "type": "property_lte",
          "path": "/workspaces/lab308e/artifacts/temperature_sensing_308e/properties/state",
          "lte": 25.5,
          "timeout_seconds": 30,
          "poll_interval_seconds": 1
        },
        {
          "type": "property_equals",
          "path": "/workspaces/lab308e/artifacts/window_308e_cover/properties/state",
          "equals": "open",
          "timeout_seconds": 30,
          "poll_interval_seconds": 1
        },
        {
          "type": "property_equals",
          "path": "/workspaces/lab308e/artifacts/ceiling_fan_308e/properties/state",
          "equals": "on",
          "timeout_seconds": 30,
          "poll_interval_seconds": 1
        }
      ]
    },
    {
      "type": "final_reply_contains",
      "value": "success"
    }
  ]
}
