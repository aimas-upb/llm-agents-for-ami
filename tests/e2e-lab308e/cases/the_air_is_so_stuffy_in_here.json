{
  "name": "the_air_is_so_stuffy_in_here_opens_window_and_reduces_co2",
  "initial_state": [
    {
      "type": "request",
      "method": "POST",
      "path": "/workspaces/lab308e/artifacts/window_308e_cover/ha/cover/close_cover",
      "json": {},
      "expect_status": 200
    },
    {
      "type": "request",
      "method": "POST",
      "url": "http://localhost:8123/api/states/sensor.co2_sensing_308e",
      "headers": {
        "Authorization": "Bearer ${HA_TOKEN}"
      },
      "json": {
        "state": 1600,
        "attributes": {
          "unit_of_measurement": "ppm",
          "friendly_name": "co2_sensing_308e"
        }
      },
      "expect_status": 200
    },
    {
      "type": "request",
      "method": "POST",
      "url": "http://localhost:8123/api/states/sensor.person_counter_308e",
      "headers": {
        "Authorization": "Bearer ${HA_TOKEN}"
      },
      "json": {
        "state": 1,
        "attributes": {
          "unit_of_measurement": "persons",
          "friendly_name": "person_counter_308e"
        }
      },
      "expect_status": 200
    },
    {
      "type": "request",
      "method": "POST",
      "url": "http://localhost:8123/api/states/binary_sensor.presence_sensing_308e",
      "headers": {
        "Authorization": "Bearer ${HA_TOKEN}"
      },
      "json": {
        "state": "on",
        "attributes": {
          "device_class": "occupancy",
          "friendly_name": "presence_sensing_308e"
        }
      },
      "expect_status": 200
    },
    {
      "type": "sleep",
      "seconds": 2
    }
  ],
  "pre_query_assertions": [
    {
      "type": "property_equals",
      "path": "/workspaces/lab308e/artifacts/window_308e_cover/properties/state",
      "equals": "closed",
      "timeout_seconds": 20,
      "poll_interval_seconds": 1
    },
    {
      "type": "property_equals",
      "path": "/workspaces/lab308e/artifacts/ceiling_fan_308e/properties/state",
      "equals": "off",
      "timeout_seconds": 20,
      "poll_interval_seconds": 1
    },
    {
      "type": "property_gte",
      "path": "/workspaces/lab308e/artifacts/co2_sensing_308e/properties/state",
      "gte": 1550,
      "timeout_seconds": 20,
      "poll_interval_seconds": 1
    },
    {
      "type": "property_lte",
      "path": "/workspaces/lab308e/artifacts/co2_sensing_308e/properties/state",
      "lte": 1650,
      "timeout_seconds": 20,
      "poll_interval_seconds": 1
    },
    {
      "type": "property_equals",
      "path": "/workspaces/lab308e/artifacts/person_counter_308e/properties/state",
      "equals": 1,
      "timeout_seconds": 20,
      "poll_interval_seconds": 1
    },
    {
      "type": "property_equals",
      "path": "/workspaces/lab308e/artifacts/presence_sensing_308e/properties/state",
      "equals": "on",
      "timeout_seconds": 20,
      "poll_interval_seconds": 1
    }
  ],
  "query": "the air is so stuffy in here",
  "semantic_expectations": {
    "target_properties": ["air_quality"],
    "preferred_artifacts": ["window_308e_cover", "ceiling_fan_308e"],
    "acceptable_artifacts": ["window_308e_cover", "ceiling_fan_308e", "air_conditioner_308e"],
    "forbidden_artifacts": ["projector_308e", "display_wall_308e", "blackout_blinds_308e_cover"],
    "must_avoid_exact_numeric_thresholds": true
  },
  "clarification_replies": [
    {
      "match_type": "regex",
      "match": "(?i)(would you like me|which would you like me to do).*?(air conditioner|ceiling fan|fan|window|window/cover).*?(improve|ventilation|air|\\?)",
      "reply": "open the window to improve ventilation"
    },
    {
      "match_type": "regex",
      "match": "(?i)would you like me to turn on the air conditioner.*",
      "reply": "open the window to improve ventilation"
    }
  ],
  "auto_confirm": true,
  "confirmation_text": "yes",
  "settle_seconds": 8,
  "pass_criteria": [
    {
      "type": "property_equals",
      "path": "/workspaces/lab308e/artifacts/window_308e_cover/properties/state",
      "equals": "open",
      "timeout_seconds": 30,
      "poll_interval_seconds": 1
    },
    {
      "type": "property_lte",
      "path": "/workspaces/lab308e/artifacts/co2_sensing_308e/properties/state",
      "lte": 2100,
      "timeout_seconds": 60,
      "poll_interval_seconds": 1
    },
    {
      "type": "final_reply_contains",
      "value": "success"
    }
  ]
}
