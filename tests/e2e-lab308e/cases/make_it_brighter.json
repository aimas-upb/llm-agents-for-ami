  "auto_confirm": true,
  "confirmation_text": "yes",
  "settle_seconds": 3,
  "pass_criteria": [
    {
      "type": "all_of",
      "assertions": [
        {
          "type": "property_gte",
          "path": "/workspaces/lab308e/artifacts/internal_light_sensing_308e/properties/state",
          "gte": 200,
          "timeout_seconds": 30,
          "poll_interval_seconds": 1
        },
        {
          "type": "property_gte",
          "path": "/workspaces/lab308e/artifacts/desk_light_sensing_308e/properties/state",
          "gte": 300,
          "timeout_seconds": 30,
          "poll_interval_seconds": 1
        }
      ]
    },
    {
      "type": "final_reply_contains",
      "value": "success"
    }
  ]
}
