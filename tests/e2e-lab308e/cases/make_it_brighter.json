{
  "name": "make_it_brighter_increases_workspace_light",
  "initial_state": [
    {
      "type": "request",
      "method": "POST",
      "path": "/workspaces/lab308e/artifacts/ambient_lights_308e/ha/light/turn_off",
      "json": {},
      "expect_status": 200
    },
    {
      "type": "request",
      "method": "POST",
      "path": "/workspaces/lab308e/artifacts/task_lights_308e/ha/light/turn_off",
      "json": {},
      "expect_status": 200
    },
    {
      "type": "request",
      "method": "POST",
      "path": "/workspaces/lab308e/artifacts/desk_lamp_308e/ha/light/turn_off",
      "json": {},
      "expect_status": 200
    },
    {
      "type": "request",
      "method": "POST",
      "path": "/workspaces/lab308e/artifacts/blinds_308e_cover/ha/cover/close_cover",
      "json": {},
      "expect_status": 200
    },
    {
      "type": "sleep",
      "seconds": 2
    }
  ],
  "query": "make it brighter",
  "semantic_expectations": {
    "target_properties": ["luminosity"],
    "preferred_artifacts": ["ambient_lights_308e", "task_lights_308e", "desk_lamp_308e", "blinds_308e_cover", "window_308e_cover"],
