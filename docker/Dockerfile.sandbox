FROM python:3.11-slim

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash sandbox

WORKDIR /sandbox

# Install only allowed dependencies
RUN pip install --no-cache-dir \
    aiohttp==3.9.1 \
    networkx==3.2.1

# Switch to non-root user
USER sandbox

# Copy execution script (will be mounted at runtime)
# The generated code will be written to /sandbox/plan.py

# Set restrictive Python options
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Default command - execute the plan script
CMD ["python", "/sandbox/plan.py"]
