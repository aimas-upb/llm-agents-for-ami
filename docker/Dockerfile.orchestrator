FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI for spawning sandbox containers
RUN curl -fsSL https://get.docker.com -o get-docker.sh && \
    sh get-docker.sh && \
    rm get-docker.sh

# Copy requirements and install Python dependencies
COPY rd5/requirements.txt /app/rd5/requirements.txt
RUN pip install --no-cache-dir -r rd5/requirements.txt

# Copy application code
COPY rd5/ /app/rd5/
COPY ami_agents/shared/models/ /app/ami_agents/shared/models/

# Set Python path
ENV PYTHONPATH=/app

# Expose port
EXPOSE 8080

# Run the orchestrator API
CMD ["uvicorn", "rd5.api.main:app", "--host", "0.0.0.0", "--port", "8080"]
