:TvBrightness a owl:Class ;
    rdfs:label "Tv Brightness"@en ;
    rdfs:comment """How brightly a lamp emits, as a level from its own minimum to maximum, on a tv."""@en ;
    rdfs:subClassOf :LevelControlBrightness .

:DimmableLightOptions a owl:Class ;
