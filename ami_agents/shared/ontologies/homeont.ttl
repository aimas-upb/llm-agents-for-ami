################################################################################
# 5. Observable measurements  (sosa:ObservableProperty)
#
# Measured values of physical quantities, each carrying its QUDT quantity kind and
# unit -- the same treatment the four room environmental variables get.
#
# 10 classes.
################################################################################

:EnergyImported a owl:Class ;
    rdfs:label "Energy Imported"@en ;
    rdfs:comment """Cumulative or periodic electrical energy the device has consumed."""@en ;
    qudt:hasQuantityKind quantitykind:Energy ;
    qudt:unit unit:MilliW-HR ;
    rdfs:subClassOf sosa:ObservableProperty .

:ElectricCurrent a owl:Class ;
    rdfs:label "Electric Current"@en ;
    rdfs:comment """The electrical current the device is drawing."""@en ;
    qudt:hasQuantityKind quantitykind:ElectricCurrent ;
    qudt:unit unit:MilliA ;
    rdfs:subClassOf sosa:ObservableProperty .

:ActivePower a owl:Class ;
    rdfs:label "Active Power"@en ;
    rdfs:comment """The real electrical power the device is drawing at this instant."""@en ;
    qudt:hasQuantityKind quantitykind:ActivePower ;
    qudt:unit unit:MilliW ;
    rdfs:subClassOf sosa:ObservableProperty .

:ApparentPower a owl:Class ;
    rdfs:label "Apparent Power"@en ;
    rdfs:comment """The apparent electrical power drawn, combining real and reactive components."""@en ;
    qudt:hasQuantityKind quantitykind:ApparentPower ;
    qudt:unit unit:MilliV-A ;
    rdfs:subClassOf sosa:ObservableProperty .

:Frequency a owl:Class ;
    rdfs:label "Frequency"@en ;
    rdfs:comment """The frequency of the electrical supply, or of the device's own drive."""@en ;
    qudt:hasQuantityKind quantitykind:Frequency ;
    qudt:unit unit:HZ ;
    rdfs:subClassOf sosa:ObservableProperty .

:PowerFactor a owl:Class ;
    rdfs:label "Power Factor"@en ;
    rdfs:comment """The ratio of real to apparent power, between 0 and 1."""@en ;
    qudt:hasQuantityKind quantitykind:DimensionlessRatio ;
    rdfs:subClassOf sosa:ObservableProperty .

:Voltage a owl:Class ;
    rdfs:label "Voltage"@en ;
    rdfs:comment """The electrical supply voltage measured at the device."""@en ;
    qudt:hasQuantityKind quantitykind:Voltage ;
    qudt:unit unit:MilliV ;
    rdfs:subClassOf sosa:ObservableProperty .

:FanSpeed a owl:Class ;
    rdfs:label "Fan Speed"@en ;
    rdfs:comment """The speed the fan is actually running at, as a percentage. The read-back of the requested speed, which it approaches over time."""@en ;
    qudt:hasQuantityKind quantitykind:DimensionlessRatio ;
    qudt:unit unit:PERCENT ;
    rdfs:subClassOf sosa:ObservableProperty .

:RemainingTime a owl:Class ;
    rdfs:label "Remaining Time"@en ;
    rdfs:comment """How long the device expects the current operation or transition to take."""@en ;
    qudt:hasQuantityKind quantitykind:Time ;
    qudt:unit unit:SEC ;
    rdfs:subClassOf sosa:ObservableProperty .

:CompartmentTemperature a owl:Class ;
    rdfs:label "Compartment Temperature"@en ;
    rdfs:comment """The temperature inside an appliance's own compartment, such as a freezer or refrigerator interior. This is NOT the temperature of the room the appliance stands in -- a freezer reads well below freezing in a warm kitchen."""@en ;
    qudt:hasQuantityKind quantitykind:ThermodynamicTemperature ;
    qudt:unit unit:DEG_C ;
    rdfs:subClassOf sosa:ObservableProperty .

################################################################################
# 6. Device state  (saref:State)
#
# Categorical conditions a device is in: running, idle, faulted, docked. SAREF
# models these as States rather than as measured quantities, because they are
# categorical rather than numeric.
#
# 47 classes.
################################################################################

:ChannelCurrentChannel a owl:Class ;
