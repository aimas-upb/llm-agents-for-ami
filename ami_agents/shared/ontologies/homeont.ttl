################################################################################
# 7. Device capabilities  (ssn-system:SystemCapability)
#
# Declarations of what a device CAN do -- the modes it supports, the spin speeds it
# offers, the phases an operation passes through. A planner reads one of these to
# choose a legal value for a sibling actuatable property. They are NOT readings and
# never change as a result of acting.
#
# 19 classes.
################################################################################

:ChannelChannelList a owl:Class ;
    rdfs:label "Channel Channel List"@en ;
    rdfs:comment """The channel channel list reported by the device."""@en ;
    rdfs:subClassOf :DeviceCapabilityProperty .

