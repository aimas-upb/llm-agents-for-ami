    rdfs:subClassOf :DeviceStateProperty .

:ElectricalPowerMeasurementNumberOfMeasurementTypes a owl:Class ;
    rdfs:label "Electrical Power Measurement Number Of Measurement Types"@en ;
    rdfs:comment """The electrical power measurement number of measurement types reported by the device."""@en ;
    rdfs:subClassOf :DeviceStateProperty .

:ElectricalPowerMeasurementPowerMode a owl:Class ;
    rdfs:label "Electrical Power Measurement Power Mode"@en ;
    rdfs:comment """The electrical power measurement power mode reported by the device."""@en ;
    rdfs:subClassOf :DeviceStateProperty .

:LevelControlMaxFrequency a owl:Class ;
    rdfs:label "Level Control Max Frequency"@en ;
    rdfs:comment """The level control max frequency reported by the device."""@en ;
    rdfs:subClassOf :DeviceStateProperty .

:LevelControlMaxLevel a owl:Class ;
    rdfs:label "Level Control Max Level"@en ;
    rdfs:comment """The level control max level reported by the device."""@en ;
    rdfs:subClassOf :DeviceStateProperty .

:LevelControlMinFrequency a owl:Class ;
    rdfs:label "Level Control Min Frequency"@en ;
    rdfs:comment """The level control min frequency reported by the device."""@en ;
    rdfs:subClassOf :DeviceStateProperty .

:LevelControlMinLevel a owl:Class ;
    rdfs:label "Level Control Min Level"@en ;
    rdfs:comment """The level control min level reported by the device."""@en ;
    rdfs:subClassOf :DeviceStateProperty .

:MediaPlaybackCurrentState a owl:Class ;
    rdfs:label "Media Playback Current State"@en ;
    rdfs:comment """The media playback current state reported by the device."""@en ;
    rdfs:subClassOf :DeviceStateProperty .

:OnOffGlobalSceneControl a owl:Class ;
    rdfs:label "On/Off Global Scene Control"@en ;
    rdfs:comment """The on/off global scene control reported by the device."""@en ;
    rdfs:subClassOf :DeviceStateProperty .

:OperationalStateCurrentPhase a owl:Class ;
    rdfs:label "Operational State Current Phase"@en ;
    rdfs:comment """The operational state current phase reported by the device."""@en ;
    rdfs:subClassOf :DeviceStateProperty .

:OperationalStateOperationalError a owl:Class ;
    rdfs:label "Operational State Operational Error"@en ;
    rdfs:comment """The operational state operational error reported by the device."""@en ;
