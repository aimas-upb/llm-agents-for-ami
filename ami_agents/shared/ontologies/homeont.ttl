    rdfs:comment """Flags altering how level changes behave, such as whether a change applies while the device is off, on a dimmable light."""@en ;
    rdfs:subClassOf :LevelControlOptions .

:TvOptions a owl:Class ;
    rdfs:label "Tv Options"@en ;
    rdfs:comment """Flags altering how level changes behave, such as whether a change applies while the device is off, on a tv."""@en ;
    rdfs:subClassOf :LevelControlOptions .

:DimmableLightOnOffTransitionTime a owl:Class ;
