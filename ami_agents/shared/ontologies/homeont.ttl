@prefix : <http://example.org/homeont/> .
# Same namespace under its conventional label. The file is authored with the
# empty prefix, but this ontology is also injected verbatim into LLM prompts,
# where terms are referred to as `homeont:Kitchen` -- declaring both keeps the
# text the model reads and the text it is asked to produce in one vocabulary.
@prefix homeont: <http://example.org/homeont/> .
@prefix hmas: <https://purl.org/hmas/> .
@prefix td: <https://www.w3.org/2019/wot/td#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix js: <https://www.w3.org/2019/wot/json-schema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix saref: <https://saref.etsi.org/core/> .
@prefix ssn-system: <http://www.w3.org/ns/ssn/systems/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/homeont/> a owl:Ontology ;
    rdfs:label "Home Ontology"@en ;
    rdfs:comment """Vocabulary for smart-home environments: the spaces of a
building, the devices situated in them, the environment within a space, and the
observable properties of that environment.

Four groups of terms:

  * BUILDING SPACES -- kitchens, bedrooms, utility rooms. A space is where
    things ARE.
  * THE ENVIRONMENT of a space -- a distinct resource, and the sosa:FeatureOfInterest
    whose properties sensors observe and actuators change. A device is located
    in a space; only a device that perceives or affects one of the environment's
    variables relates to the environment. A freezer sits in a kitchen but senses
    its own compartment, not the kitchen's air.
  * DEVICE FAMILIES -- anchored to SAREF, which defines exactly five subclasses
    of saref:Device (Actuator, Appliance, HVAC, Meter, Sensor).
  * ANNOTATIONS used when projecting devices as W3C Thing Descriptions,
    including Matter provenance kept out of IRIs and URLs."""@en ;
    owl:imports <http://www.w3.org/ns/sosa/> .

# Spaces, devices, and the environment, for smart environments (homes, offices).

# ===============================================================================
# Building and Building Space Types (House, Apartment, Office, Dining Room, etc.)
# ===============================================================================

:Building a owl:Class ;
    rdfs:comment "A building represents a structure that provides shelter for its occupants or contents and stands in one place. The building is also used to provide a basic element within the spatial structure hierarchy for the components of a building project (together with site, storey, and space)."@en ;
    rdfs:label "Building"@en .

:BuildingSpace a owl:Class ;
    rdfs:comment "An entity used to define the physical spaces of the building. A building space contains devices or other building space objects."@en ; 
    rdfs:label "Building Space"@en .

:Balcony a owl:Class ;
    rdfs:subClassOf :BuildingSpace ;
    rdfs:comment "A Balcony is a kind of BuildingSpace: an outdoor or semi-outdoor elevated platform attached to a building such as a house or apartment." ;
    rdfs:label "Balcony"@en .

:Bathroom a owl:Class ;
    rdfs:subClassOf :BuildingSpace ;
    rdfs:comment "A Bathroom is a kind of BuildingSpace: a room equipped with bathing and sanitary facilities." ;
    rdfs:label "Bathroom"@en .

:Bedroom a owl:Class ;
    rdfs:subClassOf :BuildingSpace ;
    rdfs:comment "A Bedroom is a kind of BuildingSpace: a room furnished for sleeping." ;
    rdfs:label "Bedroom"@en .

:Corridor a owl:Class ;
    rdfs:subClassOf :BuildingSpace ;
    rdfs:comment "A Corridor is a kind of BuildingSpace: a hallway or passage connecting different rooms in the home." ;
    rdfs:label "Corridor"@en .

:DiningRoom a owl:Class ;
    rdfs:subClassOf :BuildingSpace ;
    rdfs:comment "A DiningRoom is a kind of BuildingSpace: a room designated for eating meals." ;
    rdfs:label "Dining Room"@en .

:Foyer a owl:Class ;
    rdfs:subClassOf :BuildingSpace ;
    rdfs:comment "A Foyer is a kind of BuildingSpace: an entrance hall or lobby area of the home." ;
    rdfs:label "Foyer"@en .

:Garage a owl:Class ;
    rdfs:subClassOf :BuildingSpace ;
    rdfs:comment "A Garage is a kind of BuildingSpace: an enclosed space for parking vehicles and storage." ;
    rdfs:label "Garage"@en .

:GuestBedroom a owl:Class ;
    rdfs:subClassOf :Bedroom ;
    rdfs:comment "A GuestBedroom is a kind of BuildingSpace: a bedroom designated for guests." ;
    rdfs:label "Guest Bedroom"@en .

:KidsRoom a owl:Class ;
    rdfs:subClassOf :Bedroom ;
    rdfs:comment "A KidsRoom is a kind of Bedroom: a bedroom designated for children, typically combining sleeping and play areas." ;
    rdfs:label "Kids Room"@en .

:Kitchen a owl:Class ;
    rdfs:subClassOf :BuildingSpace ;
    rdfs:comment "A Kitchen is a kind of BuildingSpace: a room used for cooking and food preparation." ;
    rdfs:label "Kitchen"@en .

:LivingRoom a owl:Class ;
    rdfs:subClassOf :BuildingSpace ;
    rdfs:comment "A LivingRoom is a kind of BuildingSpace: a main living area used for relaxation and socializing." ;
    rdfs:label "Living Room"@en .

:MasterBedroom a owl:Class ;
    rdfs:subClassOf :Bedroom ;
    rdfs:comment "A MasterBedroom is a kind of BuildingSpace: the primary bedroom in the home." ;
    rdfs:label "Master Bedroom"@en .

:Office a owl:Class ;
    rdfs:subClassOf :BuildingSpace ;
    rdfs:comment "An Office is a kind of BuildingSpace: a room used for professional or administrative work." ;
    rdfs:label "Office"@en .

:StoreRoom a owl:Class ;
    rdfs:subClassOf :BuildingSpace ;
    rdfs:comment "A StoreRoom is a kind of BuildingSpace: a room used for storing household items." ;
    rdfs:label "Store Room"@en .

:StudyRoom a owl:Class ;
    rdfs:subClassOf :BuildingSpace ;
    rdfs:comment "A StudyRoom is a kind of BuildingSpace: a room designated for reading, working, or studying." ;
    rdfs:label "Study Room"@en .

:UtilityRoom a owl:Class ;
    rdfs:subClassOf :BuildingSpace ;
    rdfs:comment "A UtilityRoom is a kind of BuildingSpace: a room housing laundry and household service appliances." ;
    rdfs:label "Utility Room"@en .

# ================================================
# Properties for Building and Building Space Types
# ================================================

:hasSpace a owl:ObjectProperty ;
    rdfs:domain :Building, :BuildingSpace ;
    rdfs:range :BuildingSpace ;
    rdfs:comment "A property that relates a Building or BuildingSpace to its constituent BuildingSpaces."@en ;
    rdfs:label "hasSpace"@en .

:isSpaceOf a owl:ObjectProperty ;
    rdfs:domain :BuildingSpace ;
    rdfs:range :Building, :BuildingSpace ;
    rdfs:comment "A property that relates a BuildingSpace to the Building or BuildingSpace it is part of."@en ;
    rdfs:label "isSpaceOf"@en ;
    owl:inverseOf :hasSpace .

# ===============================================================================
# Situating artifacts in space
#
# An HMAS artifact stands for a device that physically sits somewhere. That is a
# purely spatial fact, and it is separate from what the device observes or acts
# on: a freezer is located in a kitchen but senses its own compartment, not the
# kitchen's air.
# ===============================================================================

:isLocatedIn a owl:ObjectProperty ;
    rdfs:domain hmas:Artifact ;
    rdfs:range :BuildingSpace ;
    rdfs:comment "Relates an artifact to the building space it is physically located in. Purely spatial: it says nothing about what the device senses or affects."@en ;
    rdfs:label "isLocatedIn"@en ;
    owl:inverseOf :containsArtifact .

:containsArtifact a owl:ObjectProperty ;
    rdfs:domain :BuildingSpace ;
    rdfs:range hmas:Artifact ;
    rdfs:comment "Relates a building space to the artifacts physically located in it."@en ;
    rdfs:label "containsArtifact"@en ;
    owl:inverseOf :isLocatedIn .

:isSpaceOfWorkspace a owl:ObjectProperty ;
    rdfs:domain :BuildingSpace ;
    rdfs:range hmas:Workspace ;
    rdfs:comment "Relates a building space to the HMAS workspace that groups the artifacts situated in it. The workspace is a logical container; the space is the physical room."@en ;
    rdfs:label "isSpaceOfWorkspace"@en ;
    owl:inverseOf :hasSpace .

# ===============================================================================
# The environment of a building space
#
# A space and the environment within it are two distinct resources. The space is
# where things ARE; the environment is what is OBSERVED and ACTED ON -- the air
# whose temperature, humidity, illuminance and particulate concentration sensors
# measure and actuators change.
#
# Only devices that actually perceive or affect one of those variables relate to
# the environment. Every device relates to the space.
# ===============================================================================

:Environment a owl:Class ;
    rdfs:subClassOf sosa:FeatureOfInterest ;
    rdfs:comment "The environment within a building space: the feature of interest whose observable properties (air temperature, relative humidity, illuminance, particulate concentration) sensors observe and actuators change."@en ;
    rdfs:label "Environment"@en .

:hasEnvironment a owl:ObjectProperty ;
    rdfs:domain :BuildingSpace ;
    rdfs:range :Environment ;
    rdfs:comment "Relates a building space to the environment within it."@en ;
    rdfs:label "hasEnvironment"@en ;
    owl:inverseOf :isEnvironmentOf .

:isEnvironmentOf a owl:ObjectProperty ;
    rdfs:domain :Environment ;
    rdfs:range :BuildingSpace ;
    rdfs:comment "Relates an environment to the building space it belongs to."@en ;
    rdfs:label "isEnvironmentOf"@en ;
    owl:inverseOf :hasEnvironment .

################################################################################
# Matter provenance annotations
#
# Matter names are provenance, not identity: the planner addresses a property by
# its `td:name`, and SHTD resolves that back to cluster / attribute / endpoint
# from the registry when it dispatches. These properties record the origin so
# nothing is lost, while keeping cluster ids out of the URL surface.
################################################################################

:matterType a owl:DatatypeProperty ;
	rdfs:label "Matter type"@en ;
	rdfs:comment """The Matter data-model type of a value, verbatim from the
registry -- "bool", "uint8", "temperature", "SystemModeEnum",
"ChannelInfoStruct", "power-mW".

Worth keeping even though the schema is already typed: `power-mW` and `uint32`
are both js:IntegerSchema, but only the former is in milliwatts. The physical
quantity types carry their unit and scale in the name."""@en ;
	rdfs:domain js:DataSchema ;
	rdfs:range xsd:string .

:matterEntryType a owl:DatatypeProperty ;
	rdfs:label "Matter entry type"@en ;
	rdfs:comment """Element type of a list-valued attribute. Matter declares such
an attribute as type "list" and puts the element type in a child <entry>, so
"list" alone says nothing about what the list holds."""@en ;
	rdfs:domain js:ArraySchema ;
	rdfs:range xsd:string .


# NOTE -- units are carried by `qudt:unit` alone.
#
# A local unit-symbol property was removed as redundant: the QUDT unit IRI
# already carries `qudt:symbol` ("°C", "mW") and a language-less `rdfs:label`
# ("Degree Celsius"), so restating the symbol added nothing.
#
# TODO (planner-context serialization): the helper functions that render a TD
# into an agent's context must resolve each qudt:unit IRI to those two values.
# QUDT publishes rdfs:label in many languages -- take the one with no language
# tag. Verified present for every unit this corpus uses.

################################################################################
# Affordance annotations -- REMOVED in phase 6.
#
# `:mechanism` and `:sosaRole` were string stand-ins for facts the graph could
# not otherwise state. Both are now carried by the affordance's CLASS:
# saref:State vs sosa:ObservableProperty vs ssn-system:SystemCapability draws
# the sosaRole distinction properly, and the dispatch mechanism was never a
# fact about the device at all -- it described how one server reached one
# simulator, which a vocabulary shared with Home Assistant and native Matter
# cannot carry. `:matterScale` went the same way: a read already returns the
# value in the unit `qudt:unit` names.
################################################################################


################################################################################
# Matter BasicInformation is NOT represented here.
#
# Vendor and product registration details are not something a planner acts on.
# A device's human-readable type is its rdfs:label -- taken from the curated
# family table, which matches Matter's ProductName on every device in the
# corpus -- and its name is its td:title, the SimuHome device id
# ("kitchen_freezer_1"), verbatim from the episode JSON and unique per home.
################################################################################

################################################################################
# Device families
#
# One class per SimuHome device family, each a subclass of a SAREF device class.
# SAREF v3.2.1 defines exactly five subclasses of saref:Device -- Actuator,
# Appliance, HVAC, Meter, Sensor -- and no others are used here. (An earlier
# draft invented `saref:Lighting`; the mapping tables now reject any SAREF
# parent SAREF does not define.)
################################################################################

:AirConditioner a owl:Class ;
	rdfs:label "Air Conditioner"@en ;
	rdfs:subClassOf saref:HVAC .

:HeatPump a owl:Class ;
	rdfs:label "Heat Pump"@en ;
	rdfs:subClassOf saref:HVAC .

:OnOffLight a owl:Class ;
	rdfs:label "On/Off Light"@en ;
	rdfs:subClassOf saref:Actuator .

:DimmableLight a owl:Class ;
	rdfs:label "Dimmable Light"@en ;
	rdfs:subClassOf saref:Actuator .

:WindowCoveringController a owl:Class ;
	rdfs:label "Window Covering Controller"@en ;
	rdfs:subClassOf saref:Actuator .

:AirPurifier a owl:Class ;
	rdfs:label "Air Purifier"@en ;
	rdfs:subClassOf saref:Appliance .

:Humidifier a owl:Class ;
	rdfs:label "Humidifier"@en ;
	rdfs:subClassOf saref:Appliance .

:Dehumidifier a owl:Class ;
	rdfs:label "Dehumidifier"@en ;
	rdfs:subClassOf saref:Appliance .

:Fan a owl:Class ;
	rdfs:label "Fan"@en ;
	rdfs:subClassOf saref:Appliance .

:Dishwasher a owl:Class ;
	rdfs:label "Dishwasher"@en ;
	rdfs:subClassOf saref:Appliance .

:LaundryWasher a owl:Class ;
	rdfs:label "Laundry Washer"@en ;
	rdfs:subClassOf saref:Appliance .

:LaundryDryer a owl:Class ;
	rdfs:label "Laundry Dryer"@en ;
	rdfs:subClassOf saref:Appliance .

:Refrigerator a owl:Class ;
	rdfs:label "Refrigerator"@en ;
	rdfs:subClassOf saref:Appliance .

:Freezer a owl:Class ;
	rdfs:label "Freezer"@en ;
	rdfs:subClassOf saref:Appliance .

:Rvc a owl:Class ;
	rdfs:label "RVC"@en ;
	skos:altLabel "Robotic Vacuum Cleaner"@en ;
	rdfs:subClassOf saref:Appliance .

:Tv a owl:Class ;
	rdfs:label "TV"@en ;
	rdfs:subClassOf saref:Appliance .

################################################################################
# Environmental properties
#
# The four variables SimuHome simulates. Named after the physical quantity they
# measure, matching their QUDT quantity kind -- not after the Matter attribute
# that happens to report them. ("Illuminance", not "luminosity".)
################################################################################

:AirTemperature a owl:Class ;
	rdfs:label "Air Temperature"@en ;
	rdfs:subClassOf sosa:ObservableProperty ;
	qudt:hasQuantityKind quantitykind:ThermodynamicTemperature ;
	qudt:unit unit:DEG_C .

:RelativeHumidity a owl:Class ;
	rdfs:label "Relative Humidity"@en ;
	rdfs:subClassOf sosa:ObservableProperty ;
	qudt:hasQuantityKind quantitykind:RelativeHumidity ;
	qudt:unit unit:PERCENT .

:Illuminance a owl:Class ;
	rdfs:label "Illuminance"@en ;
	rdfs:subClassOf sosa:ObservableProperty ;
	qudt:hasQuantityKind quantitykind:Illuminance ;
	qudt:unit unit:LUX .

:Pm10MassConcentration a owl:Class ;
	rdfs:label "PM10 Mass Concentration"@en ;
	rdfs:comment """Particulate matter up to 10 micrometres, as a mass
concentration. quantitykind:MassConcentration is the closest QUDT quantity kind;
it does not encode the particle-size cut-off, which is carried by this class."""@en ;
	rdfs:subClassOf sosa:ObservableProperty ;
	qudt:hasQuantityKind quantitykind:MassConcentration ;
	qudt:unit unit:MicroGM-PER-M3 .

################################################################################
# Phase 6 -- what an affordance IS
#
# Every property and action affordance a Thing Description serves carries a
# class from this block, so a planner reads a type rather than parsing a name.
#
# Parents come from published vocabularies -- sosa:ObservableProperty and
# sosa:ActuatableProperty (both ssn:Property), saref:State, saref:Command and
# ssn-system:SystemCapability -- because this vocabulary has to serve Home
# Assistant and native-Matter deployments, not only SimuHome.
#
# Nothing here names a protocol. Where a local name still echoes a Matter
# cluster it is a legacy of the curated mapping tables, not a statement about
# the wire format; the meaning is carried by rdfs:label and rdfs:comment.
#
# Sections below, in order:
#   1. Roots
#   2. Commands -- what an action DOES
#   3. Actuatable properties -- generic
#   4. Actuatable properties -- per-family leaves
#   5. Observable measurements
#   6. Device state
#   7. Device capabilities
#   8. Sensor metadata
################################################################################

################################################################################
# 1. Roots
#
# The three locally-defined parents. Everything below descends from one of
# these, or directly from a published vocabulary.
################################################################################

:ActuatableDeviceProperty a owl:Class ;
    rdfs:label "Actuatable Device Property"@en ;
    rdfs:comment """A property of a device that can be changed by invoking an
action. The root of the actuatable half of this vocabulary."""@en ;
    rdfs:subClassOf sosa:ActuatableProperty .

:DeviceStateProperty a owl:Class ;
    rdfs:label "Device State Property"@en ;
    rdfs:comment """A readable condition a device is in -- running, idle,
faulted, docked. SAREF models these as States rather than as measured
quantities, because they are categorical rather than numeric."""@en ;
    rdfs:subClassOf saref:State .

:DeviceCapabilityProperty a owl:Class ;
    rdfs:label "Device Capability Property"@en ;
    rdfs:comment """A declaration of what a device CAN do -- the modes it
supports, the spin speeds it offers, the phases an operation passes through. A
planner reads one of these to choose a legal value for a sibling actuatable
property. It is not a reading and never changes as a result of acting."""@en ;
    rdfs:subClassOf ssn-system:SystemCapability .

################################################################################
# 2. Commands -- what an action DOES  (saref:Command)
#
# Action affordances are typed with the operation they perform, not with how
# this server dispatches it. SAREF's command taxonomy is flat and mostly
# sufficient: level and setpoint writes use `saref:SetAbsoluteLevelCommand`
# DIRECTLY, with no local class at all. Only these two need defining, and each
# records why SAREF could not simply be reused.
################################################################################

:SetOnOffCommand a owl:Class ;
    rdfs:label "Set On/Off Command"@en ;
    rdfs:comment """Sets a device's on/off state to a supplied boolean.

SAREF's OnCommand, OffCommand and ToggleCommand each FIX the value they write,
so no single one of them describes this affordance: it is keyed by the attribute
and carries the value as an argument, driving all three. It is therefore a
specialisation of all three -- invoked with true it is an OnCommand, with false
an OffCommand -- rather than falling back to a bare saref:Command, which would
discard what SAREF already states."""@en ;
    rdfs:subClassOf saref:OnCommand, saref:OffCommand, saref:ToggleCommand ;
    saref:actsUpon :OnOff .

:SetModeCommand a owl:Class ;
    rdfs:label "Set Mode Command"@en ;
    rdfs:comment """Selects one named alternative from a set the device
declares -- a wash programme, an HVAC mode, a cleaning thoroughness.

This is the one command class with no SAREF equivalent. SAREF covers switching
(On/Off/Toggle), levels (SetAbsoluteLevel, SetRelativeLevel, StepUp/StepDown),
apertures (Open/Close) and lifecycle (Start/Stop/Pause), but has no term for
choosing among named alternatives, so it is defined here directly under
saref:Command. The permitted values come from the device's matching capability
property."""@en ;
    rdfs:subClassOf saref:Command .

################################################################################
# 3. Actuatable properties -- generic  (sosa:ActuatableProperty)
#
# What a planner queries when it wants "anything that can be switched on",
# independent of which device family provides it.
#
# 31 classes.
################################################################################

:DishwasherModeCurrentMode a owl:Class ;
    rdfs:label "Dishwasher Mode Current Mode"@en ;
    rdfs:comment """The selected wash programme of a dishwasher, chosen from the modes it supports."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:FanControlFanMode a owl:Class ;
    rdfs:label "Fan Control Fan Mode"@en ;
    rdfs:comment """The named speed setting of a fan (off, low, medium, high, auto). A coarser control than the percentage setting, and the one most device rules test."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:FanControlFanSpeed a owl:Class ;
    rdfs:label "Fan Control Fan Speed"@en ;
    rdfs:comment """How fast a fan runs, as a percentage of its maximum. Higher speeds move more air, which is how fans, purifiers and humidifiers reach their effect faster."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:LaundryDryerControlsSelectedDrynessLevel a owl:Class ;
    rdfs:label "Laundry Dryer Controls Selected Dryness Level"@en ;
    rdfs:comment """How dry the dryer should leave the load."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:LaundryWasherControlsNumberOfRinses a owl:Class ;
    rdfs:label "Laundry Washer Controls Number Of Rinses"@en ;
    rdfs:comment """How many rinse cycles the washer will run."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:LaundryWasherControlsSpinSpeedCurrent a owl:Class ;
    rdfs:label "Laundry Washer Controls Spin Speed Current"@en ;
    rdfs:comment """The selected spin speed of a washer, chosen from the speeds that washer supports."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:LaundryWasherModeCurrentMode a owl:Class ;
    rdfs:label "Laundry Washer Mode Current Mode"@en ;
    rdfs:comment """The selected wash programme of a washing machine, chosen from the modes it supports."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:LevelControlBrightness a owl:Class ;
    rdfs:label "Level Control Brightness"@en ;
    rdfs:comment """How brightly a lamp emits, as a level from its own minimum to maximum. Raising it increases the illuminance of the room the lamp is in."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:LevelControlDefaultMoveRate a owl:Class ;
    rdfs:label "Level Control Default Move Rate"@en ;
    rdfs:comment """How quickly the level ramps when moved without an explicit rate."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:LevelControlOffTransitionTime a owl:Class ;
    rdfs:label "Level Control Off Transition Time"@en ;
    rdfs:comment """How long the device takes to fade down when switched off."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:LevelControlOnLevel a owl:Class ;
    rdfs:label "Level Control On Level"@en ;
    rdfs:comment """The level the device returns to when switched on. A stored preference, not the present level -- writing it changes nothing until the next switch-on."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:LevelControlOnOffTransitionTime a owl:Class ;
    rdfs:label "Level Control On/Off Transition Time"@en ;
    rdfs:comment """How long the device takes to fade between on and off."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:LevelControlOnTransitionTime a owl:Class ;
    rdfs:label "Level Control On Transition Time"@en ;
    rdfs:comment """How long the device takes to fade up when switched on."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:LevelControlOptions a owl:Class ;
    rdfs:label "Level Control Options"@en ;
    rdfs:comment """Flags altering how level changes behave, such as whether a change applies while the device is off."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:LevelControlStartUpCurrentLevel a owl:Class ;
    rdfs:label "Level Control Start Up Current Level"@en ;
    rdfs:comment """The level the device adopts after a power interruption. A restoration default, with no present-tense effect."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:OnOff a owl:Class ;
    rdfs:label "On/Off"@en ;
    rdfs:comment """Whether the device is powered on. Most devices refuse other operations while off, so switching on is usually the first step of any plan involving them."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:OnOffOffWaitTime a owl:Class ;
    rdfs:label "On/Off Off Wait Time"@en ;
    rdfs:comment """How long the device must remain off before it will accept being switched on again."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:OnOffOnTime a owl:Class ;
    rdfs:label "On/Off On Time"@en ;
    rdfs:comment """How long the device stays on before switching itself off again."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:OnOffStartUpOnOff a owl:Class ;
    rdfs:label "On/Off Start Up On/Off"@en ;
    rdfs:comment """Whether the device powers up on, off, or in its previous state after an interruption. A restoration default, with no present-tense effect."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:RVCCleanModeCleanCurrentMode a owl:Class ;
    rdfs:label "RVC Clean Mode Clean Current Mode"@en ;
    rdfs:comment """How thoroughly a robot vacuum cleans, such as quick or deep."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:RVCRunModeRunCurrentMode a owl:Class ;
    rdfs:label "RVC Run Mode Run Current Mode"@en ;
    rdfs:comment """Whether a robot vacuum is idle, cleaning, or returning to its dock."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:RefrigeratorAndTemperatureControlledCabinetModeCurrentMode a owl:Class ;
    rdfs:label "Refrigerator And Temperature Controlled Cabinet Mode Current Mode"@en ;
    rdfs:comment """The selected operating mode of a refrigerator or freezer cabinet, such as normal or rapid-cool."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:TemperatureControlTemperatureSetpoint a owl:Class ;
    rdfs:label "Temperature Control Temperature Setpoint"@en ;
    rdfs:comment """The target temperature for an appliance's own compartment, such as a freezer or refrigerator interior."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:ThermostatControlSequenceOfOperation a owl:Class ;
    rdfs:label "Thermostat Control Sequence Of Operation"@en ;
    rdfs:comment """Which of heating and cooling this installation is wired for. Installed capability, not a runtime control."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:ThermostatHvacMode a owl:Class ;
    rdfs:label "Thermostat Hvac Mode"@en ;
    rdfs:comment """What the climate device is trying to do: off, heating, cooling, fan-only or automatic. Cooling or heating only happens in the matching mode, so this gates the setpoints."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:WindowCoveringMode a owl:Class ;
    rdfs:label "Window Covering Mode"@en ;
    rdfs:comment """Configuration flags for a covering, such as reversed motor direction or calibration mode."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:WindowCoveringPosition a owl:Class ;
    rdfs:label "Window Covering Position"@en ;
    rdfs:comment """How far a blind or shade is drawn, as a percentage. Opening a covering raises the room's daylight illuminance; closing it lowers it."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:WindowCoveringTargetPosition a owl:Class ;
    rdfs:label "Window Covering Target Position"@en ;
    rdfs:comment """The position a covering has been commanded to reach, which it approaches over several ticks. The current position is the read-back."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:RVCCleanModeCurrentMode a owl:Class ;
    rdfs:label "RVC Clean Mode Current Mode"@en ;
    rdfs:comment """How thoroughly a robot vacuum cleans, such as quick or deep."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:RVCRunModeCurrentMode a owl:Class ;
    rdfs:label "RVC Run Mode Current Mode"@en ;
    rdfs:comment """Whether a robot vacuum is idle, cleaning, or returning to its dock."""@en ;
    rdfs:subClassOf :ActuatableDeviceProperty .

:TemperatureSetpoint a owl:Class ;
    rdfs:label "Temperature Setpoint"@en ;
    rdfs:comment """A target temperature the device is asked to reach. It is a goal, not a reading: the measured temperature approaches it over time, and only while the device is on and in a mode that acts."""@en ;
    qudt:hasQuantityKind quantitykind:ThermodynamicTemperature ;
    qudt:unit unit:DEG_C ;
    rdfs:subClassOf :ActuatableDeviceProperty .

################################################################################
# 4. Actuatable properties -- per-family leaves
#
# What a device's Thing Description actually instantiates. Each specialises
# exactly one generic class from the section above.
#
# 62 classes.
################################################################################

:AirConditionerOnOff a owl:Class ;
    rdfs:label "Air Conditioner On/Off"@en ;
