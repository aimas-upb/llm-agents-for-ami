    <owl:unionOf rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b29"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/Entertainment">
    <rdfs:label xml:lang="en">Entertainment</rdfs:label>
    <rdf:type rdf:resource="https://saref.etsi.org/core/Task"/>
    <rdfs:comment xml:lang="en">A type of task for which a device is designed</rdfs:comment>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:historyNote xml:lang="en">V3.2.1: saref:Entertainment is deprecated: may be deleted in the next major revision of SAREF</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/controls">
    <rdfs:label xml:lang="en">controls</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b51"/>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/isControlledBy"/>
    <skos:historyNote xml:lang="en">V3.2.1: Introduced property saref:controls, as sub-property of saref:actsUpon. and generalization of saref:controlsProperty.</skos:historyNote>
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/core/actsUpon"/>
    <rdfs:comment xml:lang="en">Links a device, function, command, or procedure execution, to the feature, property, or state, it controls.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b80">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/hasProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b101">
    <owl:allValuesFrom rdf:resource="https://saref.etsi.org/core/State"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/isFunctionOf">
    <rdfs:label xml:lang="en">is function of</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/core/Function"/>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/hasFunction"/>
    <rdfs:range rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b124"/>
    <skos:historyNote xml:lang="en">V3.2.1: Introduced saref:isFunctionOf.</skos:historyNote>
    <rdfs:comment xml:lang="en">Links a function to the feature kind or device it is a function of.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b32">
    <rdf:rest rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b33"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/PropertyOfInterest"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/isCommandOfInterestOf">
    <rdfs:label xml:lang="en">is command of interest of</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/core/CommandOfInterest"/>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/hasCommandOfInterest"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/core/FunctionOfInterest"/>
    <rdfs:comment xml:lang="en">Links a command of interest to the function of interest it is a command of.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/hasPrice">
    <rdfs:label xml:lang="en">has price</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/core/Price"/>
    <rdfs:comment xml:lang="en">A relationship indentifying the price associated to an entity</rdfs:comment>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:historyNote xml:lang="en">saref:hasPrice is deprecated in v3.2.1, and may be deleted in the next major revision of SAREF. Use saref:profileHasPrice instead.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b191">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b192"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b159">
    <rdf:rest rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b160"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/hasCommandKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2006/time#TemporalEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/hasInput">
    <rdfs:label xml:lang="en">has input</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b148"/>
    <skos:historyNote xml:lang="en">V3.2.1: Introduced saref:hasInput and saref:hasOutput.</skos:historyNote>
    <skos:example xml:lang="en">Different complementary commands can be defined for controlling a light. Turn on or off the light based on a desired state, toggle the light status of a specific light, set the luminosity level with a transition time, set the default transition time, start comfort.</skos:example>
    <rdfs:comment xml:lang="en">Links a command, operation, or procedure execution, to its inputs.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b182">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:cardinality>
    <owl:onProperty rdf:resource="https://saref.etsi.org/core/isOperationOf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b99">
    <rdf:rest rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b100"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/isValueOfProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/Energy">
    <rdfs:label xml:lang="en">Energy</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Property"/>
    <rdfs:comment xml:lang="en">A saref:Property related to some measurements that are characterized by a certain value measured in an energy unit (such as Kilowatt_Hour or Watt_hour). Furter specializations of the saref:Energy class can be found in the SAREF4ENER extension, where classes such as EnergyMax, EnergyMin and EnergyExpected are defined. </rdfs:comment>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:historyNote xml:lang="en">V3.2.1: saref:Energy is deprecated: may be defined as an instance of saref:Property in the next major revision of SAREF</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b66">
    <owl:allValuesFrom rdf:resource="https://saref.etsi.org/core/Commodity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#narrower"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/Task">
    <rdfs:label xml:lang="en">Task</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The goal for which a device is designed, from a user perspective.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b64"/>
    <rdfs:subClassOf rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b63"/>
    <skos:note xml:lang="en">Tasks can be accomplished by devices (saref:isAccomplishedBy).</skos:note>
    <skos:example xml:lang="en">For example, a washing machine is designed for the task of washing.</skos:example>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b152">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/ProcedureExecution"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b215">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/Device"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/Observation">
    <rdfs:label xml:lang="en">Observation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b199"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/ProcedureExecution"/>
    <rdfs:subClassOf rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b200"/>
    <rdfs:comment xml:lang="en">A saref:Observation is the act of carrying out a procedure to estimate or calculate a value of a property of a feature of interest, or a state of a feature of interest. It links to a sensor to describe what made the observation, and to the observed feature, property, property of interest, state, or state of interest. Typically, its result is a property value or a state. An observation of a state (OP saref:observes) should have a state as a result (OP saref:hasResult). Respectively, an observation of a property should have a property value as a result.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/isControlledBy">
    <rdfs:label xml:lang="en">is controlled by</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/controls"/>
    <skos:historyNote xml:lang="en">V3.2.1: Introduced property saref:isControlledBy.</skos:historyNote>
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/core/isActedUponBy"/>
    <rdfs:comment xml:lang="en">Links a feature, property, or state, to the device, function, command, or procedure execution, that controls it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b181">
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:minQualifiedCardinality>
    <owl:onClass rdf:resource="https://saref.etsi.org/core/CommandOfInterest"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://saref.etsi.org/core/represents"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/NotifyCommand">
    <rdfs:label xml:lang="en">Notify command</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Command"/>
    <rdfs:comment xml:lang="en">A type of command</rdfs:comment>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:historyNote xml:lang="en">V3.2.1: saref:NotifyCommand is deprecated: may be defined as an instance of saref:Command in the next major revision of SAREF</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/hasMeasurement">
    <rdfs:label xml:lang="en">has measurement</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/core/Measurement"/>
    <rdfs:comment xml:lang="en">A relationship between a feature of interest and a measurement about it</rdfs:comment>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:historyNote xml:lang="en">V3.2.1: Deprecated saref:hasMeasurement together with saref:Measurement.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/StartStopState">
    <rdfs:label xml:lang="en">Start stop state</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/State"/>
    <rdfs:comment xml:lang="en">A type of state</rdfs:comment>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:historyNote xml:lang="en">V3.2.1: saref:StartStopState is deprecated: will be defined as an instance of saref:State in the next major revision of SAREF</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/madeExecution">
    <rdfs:label xml:lang="en">made execution</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/madeBy"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/core/ProcedureExecution"/>
    <rdfs:comment xml:lang="en">Links an entity (e.g., device) to the procedure execution it made.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/PropertyValue">
    <rdfs:label xml:lang="en">Property Value</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b89"/>
    <rdfs:subClassOf rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b88"/>
    <skos:historyNote xml:lang="en">V3.2.1: Introduced saref:PropertyValue to simplify the association of a measure to a property, without always needing it to be a measurement made by a device.</skos:historyNote>
    <rdfs:comment xml:lang="en">Describes the value for a property. The property value is linked to its value expressed as an RDF literal (DP saref:hasValue), optionally to the unit of measurement (OP saref:isMeasuredIn), and optionally to the properties or properties of interest it is a value of (OP saref:isValueOfProperty).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b13">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b14"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/hasFunctionOfInterest">
    <rdfs:label xml:lang="en">has function of interest</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/core/Device"/>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/isFunctionOfInterestOf"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/core/FunctionOfInterest"/>
    <rdfs:comment xml:lang="en">Links a device to one of its functions of interest.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b61">
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:minCardinality>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://saref.etsi.org/core/controls"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/StopState">
    <rdfs:label xml:lang="en">Stop state</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/StartStopState"/>
    <rdfs:comment xml:lang="en">The state of a device that is STOPPED</rdfs:comment>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:historyNote xml:lang="en">V3.2.1: saref:StopState is deprecated: will be defined as an instance of saref:State in the next major revision of SAREF</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/isExecutionOf">
    <rdfs:label xml:lang="en">is execution of</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/core/ProcedureExecution"/>
    <rdfs:range rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b186"/>
    <owl:propertyChainAxiom rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b197"/>
    <owl:propertyChainAxiom rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b195"/>
    <rdfs:comment xml:lang="en">Links a command execution to the command or command of interest that was executed. Also liks an operation execution to the operation that was executed</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b184">
    <rdf:rest rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b185"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/ProcedureExecution"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b91">
    <rdf:rest rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b92"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/FeatureKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/Appliance">
    <rdfs:label xml:lang="en">Appliance</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Device"/>
    <rdfs:subClassOf rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b59"/>
    <rdfs:comment xml:lang="en">A device designed to accomplish a particular task for occupant use. It consumes, produces, or stores, some commodity.</rdfs:comment>
    <skos:historyNote xml:lang="en">V3.2.1: Definition of saref:Appliance is grounded on tasks and commodities.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b49">
    <rdf:rest rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b50"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/CommandOfInterest"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/hasDeviceKind">
    <rdfs:label xml:lang="en">has device kind</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/core/Device"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/core/FeatureKind"/>
    <rdfs:subPropertyOf rdf:resource="https://saref.etsi.org/core/hasFeatureKind"/>
    <rdfs:comment xml:lang="en">Links a device to its kind, a feature kind. Kinds of devices describe models of devices, with common properties having the same value, common states being the same, common functions, and common services.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b150">
    <rdf:rest rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b151"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/CommandOfInterest"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b65">
    <owl:allValuesFrom rdf:resource="https://saref.etsi.org/core/Commodity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b170">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/CommandOfInterest"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/hasMeterReadingType">
    <rdfs:label xml:lang="en">has meter reading type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/core/MeteringFunction"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/core/Property"/>
    <rdfs:comment xml:lang="en">A relationship identifying the reading type of a metering function (e.g., Water, Gas, Pressure , Energy , Power, etc.)</rdfs:comment>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:historyNote xml:lang="en">V3.2.1: deprecated saref:hasMeterReadingType together with saref:MeteringFunction</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b96">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b97"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b120">
    <owl:allValuesFrom rdf:resource="https://saref.etsi.org/core/Function"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#narrower"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b190">
    <owl:allValuesFrom rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b191"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://saref.etsi.org/core/isExecutionOf"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b84">
    <rdf:rest rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b85"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/hasPropertyKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/TemperatureUnit">
    <rdfs:label xml:lang="en">Temperature unit</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
    <rdfs:comment xml:lang="en">The unit of measure for temperature</rdfs:comment>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:historyNote xml:lang="en">V3.2.1: saref:TemperatureUnit is deprecated. Will be deleted in the next major revision of SAREF</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/isActedUponBy">
    <rdfs:label xml:lang="en">is acted upon by</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b28"/>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/actsUpon"/>
    <rdfs:range rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b35"/>
    <skos:historyNote xml:lang="en">V3.2.1: Introduced property saref:isActedUponBy.</skos:historyNote>
    <rdfs:comment xml:lang="en">Links a feature, property, or state, to the device, function, command, or procedure execution, that acts on it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/isFunctionOfInterestOf">
    <rdfs:label xml:lang="en">is function of interest of</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/core/FunctionOfInterest"/>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/hasFunctionOfInterest"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/core/Device"/>
    <rdfs:comment xml:lang="en">Links a function of interest to the device it is a function of.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/CommandExecution">
    <rdfs:label xml:lang="en">Command Execution</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b190"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/ProcedureExecution"/>
    <rdfs:comment xml:lang="en">Describes the execution of a command. Typically, its inputs and outputs are human understandable and relate to some feature of interest, such as its state (e.g., s4abcd:On), or the value of its temperature (e.g., property value 21.0 °C).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/hasTypicalConsumption">
    <rdfs:label xml:lang="en">has typical consumption</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">A relationship identifying the typical (energy or power) consumption of a device</rdfs:comment>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:historyNote xml:lang="en">V3.2.1: Deprecated saref:hasTypicalConsumption. May be defined as an instance of saref:Property in the next major revision of SAREF.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/source">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/hasApplicableTime">
    <rdfs:label xml:lang="en">has applicable time</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b216"/>
    <rdfs:comment xml:lang="en">Links an entity (e.g., a profile) to an instant or interval or other compound temporal entity expressed using OWL Time, which bounds temporally the applicable context of that entity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/hasPhenomenonTime">
    <rdfs:label xml:lang="en">has phenomenon time</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
    <skos:historyNote xml:lang="en">V3.2.1: Introduced saref:hasPhenomenonTime as part of general will to make SAREF and SOSA/SSN converge.</skos:historyNote>
    <rdfs:comment xml:lang="en">Links a procedure execution to the time that the result applies. It may be an interval or an instant, or some other compound temporal entity expressed using OWL Time.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/GetSensingDataCommand">
    <rdfs:label xml:lang="en">Get sensing data command</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/Command"/>
    <rdfs:comment xml:lang="en">A type of get command</rdfs:comment>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:historyNote xml:lang="en">V3.2.1: saref:GetSensingDataCommand is deprecated: may be defined as an instance of saref:Command in the next major revision of SAREF</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b12">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/FeatureOfInterest"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b198">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="https://saref.etsi.org/core/hasCommandKind"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/OnOffState">
    <rdfs:label xml:lang="en">On off state</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/State"/>
    <rdfs:comment xml:lang="en">A type of state</rdfs:comment>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:historyNote xml:lang="en">V3.2.1: saref:OnOffState is deprecated: will be defined as an instance of saref:State in the next major revision of SAREF</skos:historyNote>
  </rdf:Description>
