  <rdf:Description rdf:about="https://saref.etsi.org/core/offers">
    <rdfs:label xml:lang="en">offers</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://saref.etsi.org/core/Device"/>
    <rdfs:range rdf:resource="https://saref.etsi.org/core/Service"/>
    <rdfs:comment xml:lang="en">Links a device to a service it exposes to a network.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://saref.etsi.org/core/isOfferedBy"/>
    <skos:historyNote xml:lang="en">V3.2.1: Clarified definition of saref:offers.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/WellBeing">
    <rdfs:label xml:lang="en">WellBeing</rdfs:label>
    <rdf:type rdf:resource="https://saref.etsi.org/core/Task"/>
    <rdfs:comment xml:lang="en">A type of task for which a device is designed</rdfs:comment>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:historyNote xml:lang="en">V3.2.1: saref:WellBeing is deprecated: may be deleted in the next major revision of SAREF</skos:historyNote>
  </rdf:Description>
