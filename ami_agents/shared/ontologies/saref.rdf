    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://saref.etsi.org/core/SetLevelCommand"/>
    <rdfs:comment xml:lang="en">A type of set level command</rdfs:comment>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:historyNote xml:lang="en">V3.2.1: saref:SetRelativeLevelCommand is deprecated: may be defined as an instance of saref:Command in the next major revision of SAREF</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://saref.etsi.org/core/actsUpon">
    <rdfs:label xml:lang="en">acts upon</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b13"/>
    <rdfs:range rdf:nodeID="n9ae069beaa0c469fb7838e4d5b9df810b21"/>
    <rdfs:comment xml:lang="en">Links a device, function, command, or procedure execution, to the feature, property, or state, it acts upon.</rdfs:comment>
    <skos:historyNote xml:lang="en">V3.2.1: saref:actsUpon now holds not only between a command and a state. It generalizes actsUpon, observes, controls. Domain and range are unions of several classes.</skos:historyNote>
  </rdf:Description>
